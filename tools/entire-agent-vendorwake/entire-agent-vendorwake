#!/usr/bin/env python3
"""Entire Agent Integration Protocol (v1) adapter for Vendorwake's Migration Agent.

Implements the subcommands documented at
https://docs.entire.com/agents/agent-integration-protocol/commands.md
Vendorwake fires hooks itself (`entire hooks vendorwake <hook>` with a JSON payload on stdin);
this binary only translates those payloads and reads the transcript Vendorwake writes.

Install: put this file on PATH as `entire-agent-vendorwake` (Entire discovers `entire-agent-<name>`
binaries on PATH), then `entire enable --agent vendorwake --telemetry=false` in the repository.
The Python side lives in backend/vendorwake/integrations/entire/recorder.py. Verified with Entire CLI
0.12.0 (docs/m0-findings.md section 1). Stdlib only; needs python3 and git.

Transcripts live outside the worktree, in `<git-common-dir>/vendorwake-sessions/<session_id>.jsonl`,
so they never appear in diffs or checkpoints of the code itself.

Transcript format (JSONL, one record per line), written by Vendorwake:
  {"type": "user", "content": str, "ts": str}
  {"type": "assistant", "content": str, "model": str, "usage": {"input_tokens": int, "output_tokens": int}}
  {"type": "tool", "name": str, "input": {...}, "ok": bool}
  {"type": "summary", "content": str}
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

PROTOCOL_VERSION = 1
NAME = "vendorwake"
HOOKS = {"session-start": 1, "turn-start": 2, "turn-end": 3, "session-end": 5}
FILE_TOOLS = {"write_file", "apply_patch"}
MARKER = Path(".entire") / "vendorwake-hooks-installed"


def out(obj) -> None:
    sys.stdout.write(json.dumps(obj))


def stdin_json() -> dict:
    data = sys.stdin.buffer.read()
    return json.loads(data) if data.strip() else {}


def repo_root() -> Path:
    return Path(os.environ.get("ENTIRE_REPO_ROOT") or os.getcwd())


def session_dir(repo: Path) -> Path:
    # Outside the worktree so transcripts never show up in diffs or checkpoints.
    common = subprocess.run(
        ["git", "-C", str(repo), "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    return Path(common) / "vendorwake-sessions"


def records(path: str, offset: int = 0) -> tuple[list[dict], int]:
    raw = Path(path).read_bytes() if Path(path).exists() else b""
    chunk = raw[offset:]
    recs = [json.loads(line) for line in chunk.decode().splitlines() if line.strip()]
    return recs, len(raw)


def modified_files(recs: list[dict]) -> list[str]:
    files = [r["input"]["path"] for r in recs if r.get("type") == "tool" and r.get("name") in FILE_TOOLS and r.get("ok")]
    return sorted(set(files))


def main(argv: list[str]) -> int:
    cmd, rest = argv[0], argv[1:]
    p = argparse.ArgumentParser(add_help=False)
    for flag in ("--hook", "--repo-path", "--session-dir", "--session-id", "--session-ref", "--path", "--model"):
        p.add_argument(flag)
    for flag in ("--max-size", "--offset"):
        p.add_argument(flag, type=int, default=0)
    p.add_argument("--local-dev", action="store_true")
    p.add_argument("--force", action="store_true")
    a, _ = p.parse_known_args(rest)

    if cmd == "info":
        out({
            "protocol_version": PROTOCOL_VERSION,
            "name": NAME,
            "type": "Vendorwake",
            "description": "Vendorwake Migration Agent - evidence-backed dependency migrations",
            "protected_dirs": [".vendorwake"],
            "hook_names": list(HOOKS),
            "capabilities": {
                "hooks": True,
                "transcript_analyzer": True,
                "transcript_preparer": False,
                "token_calculator": True,
                "text_generator": False,
                "hook_response_writer": False,
                "subagent_aware_extractor": False,
            },
        })
    elif cmd == "detect":
        out({"present": True})
    elif cmd == "get-session-id":
        out({"session_id": stdin_json()["session_id"]})
    elif cmd == "get-session-dir":
        out({"session_dir": str(session_dir(Path(a.repo_path or repo_root())))})
    elif cmd == "resolve-session-file":
        out({"session_file": str(Path(a.session_dir) / f"{a.session_id}.jsonl")})
    elif cmd == "read-session":
        hook = stdin_json()
        ref = hook["session_ref"]
        recs, _ = records(ref)
        raw = Path(ref).read_bytes() if Path(ref).exists() else b""
        out({
            "session_id": hook["session_id"],
            "agent_name": NAME,
            "repo_path": str(repo_root()),
            "session_ref": ref,
            "start_time": recs[0]["ts"] if recs and "ts" in recs[0] else hook.get("timestamp"),
            "native_data": base64.b64encode(raw).decode(),
            "modified_files": modified_files(recs),
            "new_files": [],
            "deleted_files": [],
        })
    elif cmd == "write-session":
        s = stdin_json()
        if s.get("session_ref") and s.get("native_data"):
            Path(s["session_ref"]).parent.mkdir(parents=True, exist_ok=True)
            Path(s["session_ref"]).write_bytes(base64.b64decode(s["native_data"]))
    elif cmd == "read-transcript":
        sys.stdout.buffer.write(Path(a.session_ref).read_bytes())
    elif cmd == "chunk-transcript":
        data = sys.stdin.buffer.read()
        size = max(a.max_size, 1)
        out({"chunks": [base64.b64encode(data[i:i + size]).decode() for i in range(0, len(data), size)] or []})
    elif cmd == "reassemble-transcript":
        sys.stdout.buffer.write(b"".join(base64.b64decode(c) for c in stdin_json()["chunks"]))
    elif cmd == "format-resume-command":
        out({"command": f"vendorwake investigation resume --session {a.session_id}"})
    elif cmd == "parse-hook":
        if a.hook not in HOOKS:
            out(None)
            return 0
        payload = stdin_json()
        event = {
            "type": HOOKS[a.hook],
            "session_id": payload["session_id"],
            "session_ref": payload.get("session_ref", ""),
            "timestamp": payload.get("timestamp") or datetime.now(timezone.utc).isoformat(),
            "model": payload.get("model", ""),
            "metadata": payload.get("metadata", {}),
        }
        if a.hook == "turn-start":
            event["prompt"] = payload.get("user_prompt", "")
        out(event)
    elif cmd == "install-hooks":
        # Hooks are fired from Vendorwake's own process; there is no agent config file to edit.
        (repo_root() / MARKER).parent.mkdir(parents=True, exist_ok=True)
        (repo_root() / MARKER).write_text("1\n")
        out({"hooks_installed": len(HOOKS)})
    elif cmd == "uninstall-hooks":
        (repo_root() / MARKER).unlink(missing_ok=True)
    elif cmd == "are-hooks-installed":
        out({"installed": (repo_root() / MARKER).exists()})
    elif cmd == "get-transcript-position":
        out({"position": Path(a.path).stat().st_size if Path(a.path).exists() else 0})
    elif cmd == "extract-modified-files":
        recs, pos = records(a.path, a.offset)
        out({"files": modified_files(recs), "current_position": pos})
    elif cmd == "extract-prompts":
        recs, _ = records(a.session_ref, a.offset)
        out({"prompts": [r["content"] for r in recs if r.get("type") == "user"]})
    elif cmd == "extract-summary":
        recs, _ = records(a.session_ref)
        summaries = [r["content"] for r in recs if r.get("type") == "summary"]
        out({"summary": summaries[-1] if summaries else "", "has_summary": bool(summaries)})
    elif cmd == "calculate-tokens":
        data = sys.stdin.buffer.read()[a.offset:]
        recs = [json.loads(line) for line in data.decode().splitlines() if line.strip()]
        usage = [r["usage"] for r in recs if r.get("type") == "assistant" and r.get("usage")]
        out({
            "input_tokens": sum(u.get("input_tokens", 0) for u in usage),
            "output_tokens": sum(u.get("output_tokens", 0) for u in usage),
            "api_call_count": len(usage),
        })
    else:
        print(f"unsupported subcommand: {cmd}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
