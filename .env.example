# Vendorwake configuration. Copy to .env and fill in. Never commit .env.
# Comments sit on their own lines: env-file parsers disagree about inline comments.
# Variables are grouped by milestone; anything marked "later" is unused until that milestone lands.

# --- Core ---------------------------------------------------------------
# VW_ENV: local | test | staging | production
VW_ENV=local
VW_LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API
VW_CORS_ORIGINS=http://localhost:3000

# --- Database (Tiger Data / PostgreSQL) ----------------------------------
# Local docker-compose values. For Tiger Cloud use the service connection string (sslmode=require).
POSTGRES_USER=vendorwake_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=vendorwake
VW_APP_DB_PASSWORD=change-me-app
# Owner role runs migrations. App role is used by the API/worker and is subject to row-level security.
VW_MIGRATION_DATABASE_URL=postgresql+psycopg://vendorwake_owner:change-me-owner@localhost:5432/vendorwake
VW_DATABASE_URL=postgresql+psycopg://vendorwake_app:change-me-app@localhost:5432/vendorwake
# Worker role (writes global upstream data). scripts/tiger_bootstrap.py fills these for Tiger Cloud.
VW_WORKER_DB_PASSWORD=change-me-worker
VW_WORKER_DATABASE_URL=

# --- Auth0 (user login + API authorization) ------------------------------
VW_AUTH0_DOMAIN=your-tenant.us.auth0.com
VW_AUTH0_AUDIENCE=https://api.vendorwake.local
# Next.js app: names required by @auth0/nextjs-auth0 (frontend/.env.local uses the same names)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex, e.g. openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://api.vendorwake.local
# Browser-side API URL (inlined into the frontend at build time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional runtime override for server-side API calls (docker-compose sets http://api:8000)
API_BASE_URL=

# --- Sentry --------------------------------------------------------------
# Backend DSN; empty disables Sentry
VW_SENTRY_DSN=
VW_SENTRY_TRACES_SAMPLE_RATE=1.0
# Frontend DSN (later)
NEXT_PUBLIC_SENTRY_DSN=

# --- Temporal ------------------------------------------------------------
VW_TEMPORAL_ADDRESS=localhost:7233
VW_TEMPORAL_NAMESPACE=default
# Temporal Cloud only
VW_TEMPORAL_API_KEY=
# Free hosting: run `temporal server start-dev` inside the app container (history lost on restart)
VW_TEMPORAL_EMBEDDED=false
VW_TEMPORAL_DB_FILE=
# Container launcher: run the Temporal worker next to the API; optionally migrate on start
VW_RUN_WORKER=true
VW_MIGRATE_ON_START=false

# --- Model provider (open-weight; later: M3) -----------------------------
# Free: Gemma 4 on Google AI Studio (aistudio.google.com/apikey), OpenAI-compatible endpoint.
# The adapter uses "prompt" mode there (schema in the system prompt, <thought> blocks stripped, validated).
VW_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VW_LLM_API_KEY=
VW_LLM_MODEL=gemma-4-31b-it
VW_LLM_FALLBACK_MODEL=gemma-4-26b-a4b-it
# Alternative: OpenRouter's free Gemma (google/gemma-4-31b-it:free) — shared upstream pool, often rate-limited.
VW_OPENROUTER_API_KEY=
VW_EMBEDDING_BASE_URL=http://localhost:11434/v1
VW_EMBEDDING_MODEL=nomic-embed-text

# --- Sponsor integrations (later) ----------------------------------------
# M3
VW_SERPAPI_API_KEY=
# M7
VW_BROWSERBASE_API_KEY=
VW_BROWSERBASE_PROJECT_ID=
# M6
VW_BACKBOARD_API_KEY=
# M2: Auth0 connection name used with Token Vault
VW_GITHUB_CONNECTION=github
# Fine-grained GitHub token, public repositories read-only (repository analysis)
VW_GITHUB_TOKEN=

# --- Provisioning (used by scripts/, never by the running app) -----------
# Auth0 Management API M2M app: scripts/auth0_setup.py creates the web app, API, scopes and agent clients
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Render API key: scripts/deploy_render.py creates services and sets their env vars
RENDER_API_KEY=
# Written by scripts/deploy_render.py
RENDER_OWNER_ID=
RENDER_API_URL=
RENDER_WEB_URL=
# Written by scripts/auth0_setup.py: {"<agent>": {"client_id": "...", "client_secret": "..."}}
VW_AUTH0_AGENT_CREDENTIALS=

# --- Secrets at rest (later: M2) -----------------------------------------
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VW_ENCRYPTION_KEY=
